# Leave empty for local development (Vite proxies /api to the local backend).
# Set to the deployed Render service URL for production builds.
VITE_API_BASE_URL=

# Supabase Auth project (separate auth project). Both values are safe to
# expose in the frontend — token verification happens in the backend.
# Leave both empty to run without authentication.
VITE_SUPABASE_AUTH_URL=
VITE_SUPABASE_AUTH_ANON_KEY=
