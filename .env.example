# Providers
# Each provider can list several models (comma-separated). If a model/key
# hits its rate limit or quota, the next model/key is tried automatically.
# Optional plural *_API_KEYS adds more keys to rotate through.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Order in which models/providers are tried.
PROVIDER_ORDER=groq,gemini,mistral,nvidia

# Fail over if a model stalls before its first token or mid-stream.
LLM_FIRST_TOKEN_TIMEOUT_S=20
LLM_TIMEOUT_S=120
# Retry the same model/key with exponential backoff + jitter before switching.
LLM_MAX_ATTEMPTS_PER_PROVIDER=3
LLM_RETRY_BASE_DELAY_S=1
LLM_RETRY_MAX_DELAY_S=8

# Database
# Supabase → Project Settings → Database → Connection string.
# Prefer the session pooler URI on networks without IPv6. URL-encode special
# characters in the password (for example @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth (enables login when SUPABASE_AUTH_JWKS_URL is set).
# Same project as DATABASE_URL. The backend only VERIFIES tokens against
# the project's public JWKS; the anon key below is the frontend's (it
# goes into frontend/.env as VITE_SUPABASE_AUTH_ANON_KEY).
SUPABASE_AUTH_URL=https://<project-ref>.supabase.co
SUPABASE_AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_ANON_KEY=

# GitHub connector (Ask tab) — server-side only.
# Create a fine-grained token with Metadata: Read, Contents: Read,
# Issues: Read and write, Pull requests: Read and write.
# NEVER prefix this with VITE_ — VITE_ variables are published in the
# browser bundle.
GITHUB_PAT=
# Optional: repository used when a question does not name one (owner/repo).
GITHUB_DEFAULT_REPO=

# Google Workspace MCP (Ask tab) — server-side only.
# Google hosts the MCP servers; this app runs the OAuth 2.0 flow.
# Create a Web application OAuth client in Google Cloud, add the redirect
# URI below, and tick "Use this client for an AI-powered agent".
# Requires membership in the Google Workspace Developer Preview Program.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connections/google/callback
# Encrypts stored Google refresh tokens. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key invalidates every stored connection.
MCP_TOKEN_ENCRYPTION_KEY=

# App
# local = Chroma, supabase = pgvector
RETRIEVAL_BACKEND=local
# Exact host:port, or a bare host for its scheme's default port.
ALLOWED_HOSTS=localhost:8001,postman-echo.com,petstore3.swagger.io,jsonplaceholder.typicode.com
FRONTEND_ORIGIN=http://localhost:5173,https://apifix-project.pages.dev

# Local RAG knowledge base
CHROMA_DIR=backend/data/chroma
UPLOAD_DIR=backend/uploads
# Load data/kb_chunks.jsonl into Chroma on first use. Set false to start empty.
SEED_KB=true
# Gemini embeddings (same model family as cloud_llm). GEMINI_API_KEY above is
# required for embedding, not just generation.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Local tokenizer used only for chunk sizing (not for embeddings).
CHUNK_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=20

# Ingestion batching (cloud_llm defaults)
BATCH_FILE_SIZE=10
BATCH_MAX_CONCURRENCY=4
EMBED_MAX_CHUNKS_PER_REQUEST=64
EMBED_MAX_TOKENS_PER_REQUEST=8000
EMBED_REQUESTS_PER_MINUTE=60
EMBED_TOKENS_PER_MINUTE=100000
EMBED_MAX_RETRIES=3
EMBED_RETRY_BASE_DELAY_S=1
EMBED_RETRY_MAX_DELAY_S=8

# Weighted Reciprocal Rank Fusion for hybrid retrieval.
# Keyword is deliberately a small bonus: pure dense is the stronger ranker on
# the seed corpus. RRF_DENSE_ANCHOR keeps the best N dense results in order.
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=0.05
RRF_DENSE_ANCHOR=2
