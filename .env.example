# Providers
# Each provider can list several models (comma-separated). If a model/key
# hits its rate limit or quota, the next model/key is tried automatically.
# Optional plural *_API_KEYS adds more keys to rotate through.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Order in which models/providers are tried.
PROVIDER_ORDER=gemini,groq,mistral

# Fail over if a model stalls before its first token or mid-stream.
LLM_FIRST_TOKEN_TIMEOUT_S=20
LLM_TIMEOUT_S=120

# Database
# Supabase → Project Settings → Database → Connection string.
# Prefer the session pooler URI on networks without IPv6. URL-encode special
# characters in the password (for example @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Only needed if you later use the Supabase REST/JS client. The pgvector
# retriever connects directly through DATABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# App
MOCK_BASE_URL=http://localhost:8001
# local = Chroma, supabase = pgvector
RETRIEVAL_BACKEND=local
# Exact host:port, or a bare host for its scheme's default port.
ALLOWED_HOSTS=localhost:8001,postman-echo.com,petstore3.swagger.io,jsonplaceholder.typicode.com
FRONTEND_ORIGIN=http://localhost:5173

# Local RAG knowledge base
CHROMA_DIR=backend/data/chroma
UPLOAD_DIR=backend/uploads
# Load data/kb_chunks.jsonl into Chroma on first use. Set false to start empty.
SEED_KB=true
# Gemini embeddings (same model family as cloud_llm). GEMINI_API_KEY above is
# required for embedding, not just generation.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Local tokenizer used only for chunk sizing (not for embeddings).
CHUNK_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=20
